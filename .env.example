# Use a pooled Neon connection for the application runtime.
DATABASE_URL="postgresql://user:password@host-pooler.us-west-2.aws.neon.tech/database?sslmode=require"

# Use the matching direct connection for Prisma migrations and database tooling.
# This name is injected automatically by Vercel's native Neon integration.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.us-west-2.aws.neon.tech/database?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Optional. Google sign-in is hidden when either value is absent.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GROQ_API_KEY=""

# Optional in development. Both values are required to send password-reset email.
SMTP_USER=""
SMTP_PASSWORD=""
