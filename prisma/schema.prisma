// Prisma schema for CELPIP Writing Practice
// NextAuth + app tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- NextAuth tables ----
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?   // for credentials provider

  accounts Account[]
  sessions Session[]
  practiceSessions PracticeSession[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- App tables ----
model ExampleQuestion {
  id        String   @id @default(cuid())
  taskType  Int      // 1 = Email, 2 = Survey
  title     String?  // short label
  body      String   @db.Text
  sortOrder Int      @default(0)

  practiceSessions PracticeSession[]
}

model PracticeSession {
  id                    String   @id @default(cuid())
  userId                String
  taskType              Int      // 1 or 2
  questionText          String   @db.Text // full prompt (from example or custom)
  exampleQuestionId     String?  // if from example
  answerText            String   @db.Text
  evaluationRaw         String   @db.Text
  scoreOverall          Int?
  scoreContent          Int?
  scoreVocabulary       Int?
  scoreReadability      Int?
  scoreTaskFulfillment  Int?
  timeRemainingSeconds  Int?
  createdAt             DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exampleQuestion ExampleQuestion? @relation(fields: [exampleQuestionId], references: [id], onDelete: SetNull)
}
